<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="#2B0000" android:endColor="#b00000" android:angle="270"/>
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="#FF4444"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#2B0000" android:endColor="#cc0000" android:angle="270"/>
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="#FF4444"/>
        </shape>
    </item>
</selector>